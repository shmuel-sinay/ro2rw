<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RO2RW-PC</AssemblyName>
    <RootNamespace>Ro2rwPc</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>App\app.manifest</ApplicationManifest>
    <Version>2.10.1</Version>
    <Product>RO2RW PC</Product>
    <Description>Converts Android super.img partitions to read-write ext4</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Core\*.cs" />
    <Compile Include="App\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="res\mtk.exe" LogicalName="mtk.exe" Condition="Exists('res\mtk.exe')" />
    <EmbeddedResource Include="res\Magisk.apk" LogicalName="Magisk.apk" Condition="Exists('res\Magisk.apk')" />
    <EmbeddedResource Include="res\Magisk.version" LogicalName="Magisk.version" Condition="Exists('res\Magisk.version')" />
    <EmbeddedResource Include="res\mtkflash.exe" LogicalName="mtkflash.exe" Condition="Exists('res\mtkflash.exe')" />
    <EmbeddedResource Include="res\DA_PL.bin" LogicalName="DA_PL.bin" Condition="Exists('res\DA_PL.bin')" />
    <EmbeddedResource Include="res\mtkflash-README.txt" LogicalName="mtkflash-README.txt" Condition="Exists('res\mtkflash-README.txt')" />
    <EmbeddedResource Include="res\mtkflash-LICENSE.txt" LogicalName="mtkflash-LICENSE.txt" Condition="Exists('res\mtkflash-LICENSE.txt')" />
    <EmbeddedResource Include="res\mtkclient-LICENSE.txt" LogicalName="mtkclient-LICENSE.txt" Condition="Exists('res\mtkclient-LICENSE.txt')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
